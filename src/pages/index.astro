  {
    caseId: "NET-03",
    title: "Mystic Motors",
    role: "Lead Developer & Netcode Architect",
    organization: "TEC VENTURES",
    engine: "Unity // NGO Netcode",
    perf: "60 FPS",
    stamp: "GOOGLE PLAY RELEASE",
    stampType: "red" as const,
    summary: "Competitive multiplayer vehicular racing game combining high-speed drifting physics, customizable vehicles, dynamic modular tracks, and real-time spell-casting combat mechanisms.",
    features: [
      "Architected multiplayer networking using Unity Netcode for GameObjects (NGO) for low-latency synchronization.",
      "Engineered real-time vehicle raycast suspension physics, friction modeling, and nitro boost dynamics.",
      "Programmed spell-casting projectile collision mechanics and networked player buff/debuff systems."
    ],
    handwrittenTags: ["Unity", "C#", "NGO Netcode", "Vehicle Physics", "Spell Combat", "Google Play"],
    playStoreUrl: "https://play.google.com/store/apps/details?id=com.tecventures.mysticmotors&hl=en_IN"
  },
  {
    caseId: "PUZ-04",
    title: "Merge Balls",
    role: "Unity Developer",
    organization: "DevKraken",
    engine: "Unity // 2D/3D Physics",
    perf: "60 FPS",
    stamp: "GOOGLE PLAY LIVE",
    stampType: "yellow" as const,
    summary: "Physics-based number puzzle game featuring dynamic ball dropping, cascading collision merge reactions, power-up items, and combo multiplication algorithms.",
    features: [
