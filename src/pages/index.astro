---

<Layout 
  title="Sahil Ahmed // Unity Systems & Gameplay Engineer — Field Logbook"
  description="Survivor field journal & technical game dev portfolio of Sahil Ahmed: 4+ years architecting Multiplayer Netcode (NGO & Photon), Defense VR Simulations, and Google Play titles."
>
  <!-- 1. Header / Intro Journal Entry -->
  <Hero />

  <!-- 2. Project Gallery ("Field Reports") -->
  <section id="reports" class="py-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3 border-b border-[#282A2D] pb-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="stamp-ink-rust">CASE FILES</span>
          <span class="font-handwriting text-lg text-[#E0AB48]">field reports // game projects</span>
        </div>
        <h2 class="font-typewriter text-3xl sm:text-4xl font-bold text-[#E3DED1] mt-1">
          PROJECT FIELD REPORTS
        </h2>
      </div>
      <div class="font-courier text-xs text-[#A5ABB3] max-w-sm">
        *Detailed technical case files with system architecture breakdowns and tech tags.
      </div>
    </div>

    <!-- Grid of Case Files with Listen Mode Focus Effect -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {caseReports.map((report) => (
        <ProjectDossier {...report} />
      ))}
    </div>
  </section>

  <!-- 3. Tech Stack ("Gear & Inventory") -->
  <SurvivalInventory />

  <!-- 4. Experience & Timeline ("Work Logs") -->
  <MissionLogs />

  <!-- 5. Academic & Archive Records -->
  <ArchiveRecords />

  <!-- 6. Emergency Radio & Dispatch -->
  <RadioFrequencies />

  <!-- Interactive Simulation Modal -->
  <div id="sim-modal" class="fixed inset-0 z-50 hidden bg-[#0c0d0d]/90 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="field-card max-w-2xl w-full p-6 sm:p-8 bg-[#1a1b1d] border-2 border-[#C69234] relative shadow-2xl">
      <button id="modal-close" class="absolute top-4 right-4 text-[#A5ABB3] hover:text-[#E3DED1] font-typewriter text-lg font-bold">
        ✕
      </button>
      
      <div class="font-typewriter text-xs text-[#E0AB48] font-bold mb-1">
        // INTERACTIVE FIELD SIMULATION
      </div>
      <h3 id="modal-title" class="font-typewriter text-2xl font-black text-[#E3DED1] mb-4">
        GAMEPLAY SIMULATION
      </h3>

      <div class="bg-[#131415] border border-[#282A2D] rounded-xs aspect-video relative overflow-hidden flex items-center justify-center">
        <canvas id="sim-canvas" class="w-full h-full"></canvas>
        <div class="absolute top-2 left-2 font-courier text-[10px] text-[#8EA870] bg-[#1a1b1d]/90 px-2 py-0.5 border border-[#282A2D]">
          PHYSICS SOLVER: RUNNING
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between font-courier text-xs text-[#CFC8BA]">
        <span>Click inside canvas to drop physics collision entities</span>
        <button id="sim-reset" class="btn-tape-moss text-xs">
          RESET SIM
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    // Simulator Modal Controller
    const modal = document.getElementById('sim-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalClose = document.getElementById('modal-close');
    const simCanvas = document.getElementById('sim-canvas');
    let simCtx = null;
    let simBalls = [];

    if (simCanvas) {
      simCtx = simCanvas.getContext('2d');
      const resizeSim = () => {
        simCanvas.width = simCanvas.clientWidth;
        simCanvas.height = simCanvas.clientHeight;
      };
      window.addEventListener('resize', resizeSim);

      class BallEntity {
        constructor(x, y) {
          this.x = x || Math.random() * simCanvas.width;
          this.y = y || Math.random() * (simCanvas.height / 2);
          this.vx = (Math.random() - 0.5) * 5;
          this.vy = (Math.random() - 0.5) * 5;
          this.radius = Math.random() * 12 + 8;
          this.color = Math.random() > 0.5 ? '#E0AB48' : '#8EA870';
          this.label = Math.pow(2, Math.floor(Math.random() * 5) + 1);
        }
        update() {
          this.x += this.vx;
          this.y += this.vy;
          this.vy += 0.16;
          if (this.x - this.radius < 0) {
            this.vx *= -0.85;
            this.x = this.radius;
          } else if (this.x + this.radius > simCanvas.width) {
            this.vx *= -0.85;
            this.x = simCanvas.width - this.radius;
          }
          if (this.y + this.radius > simCanvas.height) {
            this.vy *= -0.72;
            this.y = simCanvas.height - this.radius;
          }
        }
        draw() {
          simCtx.beginPath();
          simCtx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
          simCtx.fillStyle = this.color;
          simCtx.fill();
          simCtx.fillStyle = '#131415';
          simCtx.font = 'bold 9px monospace';
          simCtx.textAlign = 'center';
          simCtx.textBaseline = 'middle';
          simCtx.fillText(this.label, this.x, this.y);
        }
      }

      function initSim() {
        resizeSim();
        simBalls = [];
        for (let i = 0; i < 12; i++) simBalls.push(new BallEntity());
      }

      function animSim() {
        if (!modal.classList.contains('hidden')) {
          simCtx.fillStyle = 'rgba(19, 20, 21, 0.3)';
          simCtx.fillRect(0, 0, simCanvas.width, simCanvas.height);
          simBalls.forEach(b => {
            b.update();
            b.draw();
          });
        }
        requestAnimationFrame(animSim);
      }
      animSim();

      simCanvas.addEventListener('mousedown', (e) => {
        const rect = simCanvas.getBoundingClientRect();
        simBalls.push(new BallEntity(e.clientX - rect.left, e.clientY - rect.top));
        if (simBalls.length > 25) simBalls.shift();
      });

      document.getElementById('sim-reset')?.addEventListener('click', initSim);
    }

    document.querySelectorAll('.preview-trigger-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const title = btn.getAttribute('data-title') || 'Game Simulation';
        if (modalTitle) modalTitle.textContent = title + " // Field Simulation";
        modal.classList.remove('hidden');
        if (simCanvas) {
          simCanvas.width = simCanvas.clientWidth;
          simCanvas.height = simCanvas.clientHeight;
        }
      });
    });

    modalClose?.addEventListener('click', () => modal.classList.add('hidden'));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') modal.classList.add('hidden');
    });
  </script>
</Layout>
