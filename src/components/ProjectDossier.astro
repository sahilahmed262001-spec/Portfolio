---
// src/components/ProjectDossier.astro
// Clean, High-Contrast Survivor Case File (No image thumbnails)

interface Props {
  caseId: string;
  title: string;
  role: string;
  organization: string;
  engine: string;
  perf: string;
  stamp: string;
  stampType?: 'red' | 'moss' | 'yellow';
  summary: string;
  features: string[];
  handwrittenTags: string[];
  playStoreUrl?: string;
}

const {
  caseId,
  title,
  role,
  organization,
  engine,
  perf,
  stamp,
  stampType = 'red',
  summary,
  features,
  handwrittenTags,
  playStoreUrl
} = Astro.props;
---

<div class="survivor-card rounded-xs p-6 sm:p-7 border border-[#2f3236] bg-[#18191c] relative flex flex-col justify-between transition-all duration-300 hover:-translate-y-1">
  
  <!-- Tape Corner Accent -->
  <div class="masking-tape tape-corner"></div>

  <div>
    <!-- Case File Header -->
    <div class="flex items-start justify-between border-b border-[#2b2e31] pb-3 mb-4 pr-12">
      <div>
        <span class="font-typewriter text-xs text-[#8ca672] font-bold block uppercase tracking-wider">
          CASE FILE: {caseId} &bull; {organization}
        </span>
        <h3 class="font-typewriter text-2xl font-bold text-[#ffffff] tracking-tight mt-1">
          {title}
        </h3>
      </div>
    </div>

    <!-- Stamp Badge -->
    <div class="mb-4">
      <span class={stampType === 'moss' ? 'stamp-moss' : stampType === 'yellow' ? 'stamp-yellow' : 'stamp-red'}>
        {stamp}
      </span>
    </div>

    <!-- Specs Strip -->
    <div class="bg-[#111214] p-3 rounded-xs font-typewriter text-xs text-[#f0eae1] mb-4 border border-[#26282b] flex flex-wrap items-center justify-between gap-2">
      <div>
        <span class="text-[#8c8577] uppercase font-bold">ROLE:</span> <strong class="text-[#93c572]">{role}</strong>
      </div>
      <div>
        <span class="text-[#8c8577] uppercase font-bold">ENGINE:</span> <strong class="text-[#f0c05a]">{engine}</strong> ({perf})
      </div>
    </div>

    <!-- Summary Paragraph -->
    <p class="font-serif text-sm text-[#ded7cc] leading-relaxed mb-4 bg-[#141517] p-3.5 border-l-2 border-l-[#c2412d] rounded-xs">
      {summary}
    </p>

    <!-- Key Engineered Systems -->
    <div class="mb-5 space-y-1.5">
      <div class="font-typewriter text-xs font-bold text-[#b5ac9d] uppercase">
        // ENGINEERED SYSTEMS:
      </div>
      <ul class="space-y-1.5 font-typewriter text-xs text-[#e6dfd3]">
        {features.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-[#f0c05a] font-bold mt-0.5">✔</span>
            <span class="leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div>
    <!-- Handwritten Tags -->
    <div class="border-t border-dashed border-[#2b2e31] pt-3 mb-4 flex flex-wrap items-center gap-2">
      <span class="font-typewriter text-[11px] text-[#8c8577] uppercase font-bold mr-1">TAGS:</span>
      {handwrittenTags.map((tag) => (
        <span class="font-handwriting text-base font-bold text-[#93c572] bg-[#222421] px-2 py-0.5 rounded-xs border border-[#353f2c]">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Action Buttons -->
    <div class="pt-3 border-t border-[#2b2e31] flex items-center justify-between gap-2">
      {playStoreUrl ? (
        <a 
          href={playStoreUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-typewriter text-xs font-bold text-[#f0c05a] hover:underline flex items-center gap-1.5"
        >
          <i class="fa-brands fa-google-play"></i> GOOGLE PLAY &gt;
        </a>
      ) : (
        <span class="font-typewriter text-xs text-[#93c572] font-bold flex items-center gap-1">
          <i class="fa-solid fa-shield-halved"></i> VERIFIED DEPLOYMENT
        </span>
      )}
      
      <button 
        class="preview-trigger-btn font-typewriter text-xs font-bold px-3 py-1.5 bg-[#2e3a23] hover:bg-[#3f4f30] text-[#f0eae1] border border-[#455734] transition-colors"
        data-title={title}
      >
        SIMULATOR &gt;
      </button>
    </div>
  </div>

</div>
