---
// src/components/ProjectDossier.astro
// The Last of Us Inspired Field Report Case File

interface Props {
  caseId: string;
  title: string;
  role: string;
  organization: string;
  engine: string;
  perf: string;
  stamp: string;
  stampType?: 'red' | 'moss' | 'yellow';
  summary: string;
  features: string[];
  handwrittenTags: string[];
  playStoreUrl?: string;
}

const {
  caseId,
  title,
  role,
  organization,
  engine,
  perf,
  stamp,
  stampType = 'red',
  summary,
  features,
  handwrittenTags,
  playStoreUrl
} = Astro.props;
---

<div class="field-card p-6 sm:p-7 relative flex flex-col justify-between">
  
  <!-- Physical Masking Tape Strip Corner -->
  <div class="tape-strip tape-corner-right"></div>

  <div>
    <!-- Case Header -->
    <div class="flex items-start justify-between border-b border-[#282A2D] pb-3 mb-4 pr-12">
      <div>
        <span class="font-typewriter text-xs text-[#8EA870] font-bold block uppercase tracking-wider">
          CASE FILE: {caseId} &bull; {organization}
        </span>
        <h3 class="font-typewriter text-2xl font-bold text-[#E3DED1] tracking-tight mt-1">
          {title}
        </h3>
      </div>
    </div>

    <!-- Stamped Ink Badge -->
    <div class="mb-4">
      <span class={stampType === 'moss' ? 'stamp-ink-moss' : stampType === 'yellow' ? 'stamp-ink-yellow' : 'stamp-ink-rust'}>
        {stamp}
      </span>
    </div>

    <!-- Specs Strip -->
    <div class="bg-[#151618] p-3 rounded-xs font-courier text-xs text-[#E3DED1] mb-4 border border-[#232528] flex flex-wrap items-center justify-between gap-2">
      <div>
        <span class="text-[#7A8087] uppercase font-bold">ROLE:</span> <strong class="text-[#8EA870]">{role}</strong>
      </div>
      <div>
        <span class="text-[#7A8087] uppercase font-bold">ENGINE:</span> <strong class="text-[#E0AB48]">{engine}</strong> ({perf})
      </div>
    </div>

    <!-- Summary Paragraph in Clean Legible Sans-Serif -->
    <p class="font-body text-sm text-[#CFC8BA] leading-relaxed mb-4 bg-[#161719] p-3.5 border-l-2 border-l-[#8B3A2B] rounded-xs">
      {summary}
    </p>

    <!-- Key Engineered Systems -->
    <div class="mb-5 space-y-1.5">
      <div class="font-typewriter text-xs font-bold text-[#A5ABB3] uppercase">
        // ENGINEERED SYSTEMS:
      </div>
      <ul class="space-y-1.5 font-body text-xs text-[#E3DED1]">
        {features.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-[#E0AB48] font-bold mt-0.5">✔</span>
            <span class="leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div>
    <!-- Handwritten Sharpie Tech Tags -->
    <div class="border-t border-dashed border-[#282A2D] pt-3 mb-4 flex flex-wrap items-center gap-2">
      <span class="font-typewriter text-[11px] text-[#7A8087] uppercase font-bold mr-1">TAGS:</span>
      {handwrittenTags.map((tag) => (
        <span class="font-handwriting text-base font-bold text-[#8EA870] bg-[#1e231b] px-2.5 py-0.5 rounded-xs border border-[#344129]">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Duct-Tape / Stencil Stamped Action Buttons -->
    <div class="pt-3 border-t border-[#282A2D] flex items-center justify-between gap-2">
      {playStoreUrl ? (
        <a 
          href={playStoreUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-tape-yellow text-xs"
        >
          <i class="fa-brands fa-google-play"></i> GOOGLE PLAY &gt;
        </a>
      ) : (
        <span class="font-typewriter text-xs text-[#8EA870] font-bold flex items-center gap-1.5">
          <i class="fa-solid fa-shield-halved"></i> VERIFIED DEPLOYMENT
        </span>
      )}
      
      <button 
        class="preview-trigger-btn btn-tape-moss text-xs"
        data-title={title}
      >
        SIMULATOR &gt;
      </button>
    </div>
  </div>

</div>
