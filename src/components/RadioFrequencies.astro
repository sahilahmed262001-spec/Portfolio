---
// src/components/RadioFrequencies.astro
// Grounded Emergency Radio & Written Dispatch Terminal
---

<section id="radio" class="py-14 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-3 border-b border-[#2d3033] pb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="stamp-red text-xs">RADIO STATION</span>
        <span class="font-handwriting text-lg text-[#d6a842]">direct contact // frequency</span>
      </div>
      <h2 class="font-typewriter text-3xl sm:text-4xl font-bold text-[#e6dfd3] mt-1">
        EMERGENCY RADIO &amp; DISPATCH
      </h2>
    </div>
    <div class="font-typewriter text-xs text-[#9c9384] max-w-sm">
      *Send direct transmission for studio contracts, game engineering roles, or multiplayer advisory.
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Pinned Contact Notes -->
    <div class="lg:col-span-5 space-y-4">
      <div class="paper-sheet rounded-xs p-6 border border-[#d6cdbd] relative">
        <div class="masking-tape tape-corner"></div>

        <div class="font-typewriter text-xs font-bold text-[#1c1b18] border-b border-[#cfc4b2] pb-3 mb-4 flex items-center justify-between">
          <span>📻 TRANSMISSION CHANNELS</span>
          <span class="stamp-moss text-[9px]">OPEN</span>
        </div>

        <div class="space-y-4 font-typewriter text-xs text-[#2b271f]">
          
          <div class="bg-[#ece4d6] p-3 rounded-xs border border-[#ded5c5]">
            <span class="text-[10px] text-[#7a7162] block font-bold uppercase">DIRECT PHONE / WHATSAPP:</span>
            <a href="tel:+918171638120" class="text-sm font-bold text-[#1c1b18] hover:text-[#9e3a2b] flex items-center justify-between mt-0.5">
              <span>+91 8171638120</span>
              <i class="fa-solid fa-phone text-[#2e3a23]"></i>
            </a>
          </div>

          <div class="bg-[#ece4d6] p-3 rounded-xs border border-[#ded5c5]">
            <span class="text-[10px] text-[#7a7162] block font-bold uppercase">WRITTEN DISPATCH (EMAIL):</span>
            <a href="mailto:sahilahmed262001@gmail.com" class="text-xs font-bold text-[#1c1b18] hover:text-[#9e3a2b] flex items-center justify-between mt-0.5 break-all">
              <span>sahilahmed262001@gmail.com</span>
              <i class="fa-solid fa-envelope text-[#9e3a2b]"></i>
            </a>
          </div>

          <div class="bg-[#ece4d6] p-3 rounded-xs border border-[#ded5c5]">
            <span class="text-[10px] text-[#7a7162] block font-bold uppercase">PROFESSIONAL FREQUENCY (LINKEDIN):</span>
            <a href="https://linkedin.com/in/sahil-ahmed-81018a228" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#2e3a23] hover:text-[#9e3a2b] flex items-center justify-between mt-0.5">
              <span>linkedin.com/in/sahil-ahmed-81018a228</span>
              <i class="fa-brands fa-linkedin text-[#2e3a23]"></i>
            </a>
          </div>

        </div>

        <div class="mt-5 pt-3 border-t border-[#cfc4b2] font-handwriting text-base text-[#9e3a2b] text-center font-bold">
          "Ready to join your development team"
        </div>
      </div>
    </div>

    <!-- Right Column: Dispatch Form -->
    <div class="lg:col-span-7">
      <div class="paper-sheet rounded-xs p-6 sm:p-8 border border-[#d6cdbd] relative">
        <div class="masking-tape" style="top: -10px; right: 20%; width: 90px; height: 20px; transform: rotate(1deg);"></div>

        <div class="font-typewriter text-xs font-bold text-[#1c1b18] border-b border-[#cfc4b2] pb-3 mb-5 flex items-center justify-between">
          <span>✍️ SEND WRITTEN DISPATCH</span>
          <span class="stamp-red text-[9px]">ENCRYPTED</span>
        </div>

        <form action="mailto:sahilahmed262001@gmail.com" method="GET" class="space-y-4 font-typewriter text-xs">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] text-[#595244] uppercase font-bold mb-1">
                SENDER NAME / STUDIO CALLSIGN *
              </label>
              <input 
                type="text" 
                name="subject" 
                required 
                placeholder="e.g. Lead Producer / Studio Director" 
                class="w-full bg-[#fbf8f2] border border-[#cfc4b2] p-2.5 text-[#1c1b18] placeholder-[#9c9384] rounded-xs text-xs outline-hidden focus:border-[#2e3a23]"
              />
            </div>

            <div>
              <label class="block text-[10px] text-[#595244] uppercase font-bold mb-1">
                RETURN EMAIL ADDRESS *
              </label>
              <input 
                type="email" 
                required 
                placeholder="contact@studio.com" 
                class="w-full bg-[#fbf8f2] border border-[#cfc4b2] p-2.5 text-[#1c1b18] placeholder-[#9c9384] rounded-xs text-xs outline-hidden focus:border-[#2e3a23]"
              />
            </div>
          </div>

          <div>
            <label class="block text-[10px] text-[#595244] uppercase font-bold mb-1">
              DISPATCH MESSAGE *
            </label>
            <textarea 
              name="body" 
              rows="4" 
              required 
              placeholder="Write project details, role expectations, or contract inquiries..." 
              class="w-full bg-[#fbf8f2] border border-[#cfc4b2] p-2.5 text-[#1c1b18] placeholder-[#9c9384] rounded-xs text-xs outline-hidden resize-none focus:border-[#2e3a23]"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-3 bg-[#2e3a23] hover:bg-[#3f4f30] text-[#f3eee6] font-typewriter text-xs font-bold uppercase tracking-wider shadow-md transition-all flex items-center justify-center gap-2"
          >
            <span>✉️ TRANSMIT MESSAGE DIRECTLY TO SAHIL</span>
          </button>

        </form>
      </div>
    </div>

  </div>

</section>
