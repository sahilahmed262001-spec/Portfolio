---
// src/components/RadioFrequencies.astro
// Survivor Emergency Radio & Written Dispatch Terminal
---

<section id="radio" class="py-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3 border-b border-[#282A2D] pb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="stamp-ink-rust">RADIO STATION</span>
        <span class="font-handwriting text-lg text-[#E0AB48]">direct contact // frequency</span>
      </div>
      <h2 class="font-typewriter text-3xl sm:text-4xl font-bold text-[#E3DED1] mt-1">
        EMERGENCY RADIO &amp; DISPATCH
      </h2>
    </div>
    <div class="font-courier text-xs text-[#A5ABB3] max-w-sm">
      *Send direct transmission for studio contracts, game engineering roles, or multiplayer advisory.
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left: Contact Channels -->
    <div class="lg:col-span-5 space-y-4">
      <div class="field-card p-6 bg-[#1a1b1d] border border-[#282A2D] relative">
        <div class="tape-strip tape-corner-right"></div>

        <div class="font-typewriter text-xs font-bold text-[#E3DED1] border-b border-[#282A2D] pb-3 mb-4 flex items-center justify-between">
          <span>📻 TRANSMISSION CHANNELS</span>
          <span class="stamp-ink-moss text-[9px]">OPEN</span>
        </div>

        <div class="space-y-4 font-courier text-xs text-[#CFC8BA]">
          <div class="bg-[#151618] p-3.5 rounded-xs border border-[#232528]">
            <span class="text-[10px] text-[#7A8087] block font-bold uppercase">DIRECT PHONE / WHATSAPP:</span>
            <a href="tel:+918171638120" class="text-sm font-bold text-[#E3DED1] hover:text-[#E0AB48] flex items-center justify-between mt-1">
              <span>+91 8171638120</span>
              <i class="fa-solid fa-phone text-[#8EA870]"></i>
            </a>
          </div>

          <div class="bg-[#151618] p-3.5 rounded-xs border border-[#232528]">
            <span class="text-[10px] text-[#7A8087] block font-bold uppercase">WRITTEN DISPATCH (EMAIL):</span>
            <a href="mailto:sahilahmed262001@gmail.com" class="text-xs font-bold text-[#E0AB48] hover:underline flex items-center justify-between mt-1 break-all">
              <span>sahilahmed262001@gmail.com</span>
              <i class="fa-solid fa-envelope text-[#C7523C]"></i>
            </a>
          </div>

          <div class="bg-[#151618] p-3.5 rounded-xs border border-[#232528]">
            <span class="text-[10px] text-[#7A8087] block font-bold uppercase">PROFESSIONAL FREQUENCY:</span>
            <a href="https://linkedin.com/in/sahil-ahmed-81018a228" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#8EA870] hover:underline flex items-center justify-between mt-1">
              <span>linkedin.com/in/sahil-ahmed</span>
              <i class="fa-brands fa-linkedin text-[#8EA870]"></i>
            </a>
          </div>
        </div>

        <div class="mt-5 pt-3 border-t border-[#282A2D] font-handwriting text-base text-[#E0AB48] text-center font-bold">
          "Ready to join your development team"
        </div>
      </div>
    </div>

    <!-- Right: Dispatch Form -->
    <div class="lg:col-span-7">
      <div class="field-card p-6 sm:p-8 bg-[#1a1b1d] border border-[#282A2D] relative">
        <div class="tape-strip" style="top: -10px; right: 20%; width: 90px; height: 20px; transform: rotate(1deg);"></div>

        <div class="font-typewriter text-xs font-bold text-[#E3DED1] border-b border-[#282A2D] pb-3 mb-5 flex items-center justify-between">
          <span>✍️ SEND WRITTEN DISPATCH</span>
          <span class="stamp-ink-rust text-[9px]">ENCRYPTED</span>
        </div>

        <form action="mailto:sahilahmed262001@gmail.com" method="GET" class="space-y-4 font-body text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-courier text-[#A5ABB3] uppercase font-bold mb-1">
                SENDER NAME / STUDIO CALLSIGN *
              </label>
              <input type="text" name="subject" required placeholder="e.g. Lead Producer / Studio Director" class="w-full bg-[#151618] border border-[#282A2D] p-2.5 text-[#E3DED1] placeholder-[#5c6168] rounded-xs text-xs outline-hidden focus:border-[#E0AB48]" />
            </div>

            <div>
              <label class="block text-[10px] font-courier text-[#A5ABB3] uppercase font-bold mb-1">
                RETURN EMAIL ADDRESS *
              </label>
              <input type="email" required placeholder="contact@studio.com" class="w-full bg-[#151618] border border-[#282A2D] p-2.5 text-[#E3DED1] placeholder-[#5c6168] rounded-xs text-xs outline-hidden focus:border-[#E0AB48]" />
            </div>
          </div>

          <div>
            <label class="block text-[10px] font-courier text-[#A5ABB3] uppercase font-bold mb-1">
              DISPATCH MESSAGE *
            </label>
            <textarea name="body" rows="4" required placeholder="Write project details, role expectations, or contract inquiries..." class="w-full bg-[#151618] border border-[#282A2D] p-2.5 text-[#E3DED1] placeholder-[#5c6168] rounded-xs text-xs outline-hidden resize-none focus:border-[#E0AB48]"></textarea>
          </div>

          <button type="submit" class="w-full py-3 btn-tape-yellow text-xs">
            <span>✉️ TRANSMIT MESSAGE DIRECTLY TO SAHIL</span>
          </button>
        </form>
      </div>
    </div>

  </div>

</section>
