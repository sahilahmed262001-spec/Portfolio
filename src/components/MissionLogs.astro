---
// src/components/MissionLogs.astro
// Experience & Timeline formatted as chronological journal entries on torn notebook paper

interface WorkEntry {
  company: string;
  location: string;
  role: string;
  dates: string;
  status: string;
  bullets: string[];
  tools: string[];
}

const entries: WorkEntry[] = [
  {
    company: "TEC VENTURES",
    location: "Australia (Remote)",
    role: "Senior Unity Developer",
    dates: "October 2025 – Present",
    status: "ACTIVE ENTRY // IN PROGRESS",
    bullets: [
      "Spearheaded the development, networking, and deployment of Mystic Motors on the Google Play Store.",
      "Architected and optimized multiplayer networking using Unity Netcode for GameObjects (NGO) for low-latency synchronization.",
      "Engineered real-time vehicle physics and a custom spell-casting gameplay mechanic for competitive multiplayer racing."
    ],
    tools: ["Unity 6", "C#", "NGO Netcode", "Vehicle Physics", "Spell Combat", "Google Play"]
  },
  {
    company: "Abhiwan Technology Pvt Ltd.",
    location: "New Delhi, Delhi, India",
    role: "Unity Developer",
    dates: "August 2022 – October 2025",
    status: "ARCHIVED CAMPAIGN // 3+ YEARS",
    bullets: [
      "Developed and maintained diverse casual mobile games, multiplayer systems, and immersive AR/VR projects using Unity & C#.",
      "Built and deployed an immersive VR museum experience commemorating the 100 Glorious Years of IMNS (officially inaugurated by the Chief of Defence Staff, General Anil Chauhan).",
      "Utilized ProBuilder for level blocking and rapid prototyping; managed 3D asset pipelines and integration using Blender.",
      "Collaborated with design teams via Figma to implement intuitive, responsive UI across various mobile and VR screen ratios."
    ],
    tools: ["Unity", "C#", "Photon PUN / Fusion", "VR/AR Defense Rigs", "ProBuilder", "Blender", "Figma"]
  }
];
---

<section id="journal" class="py-14 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-3 border-b border-[#2d3033] pb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="stamp-red text-xs">CHRONICLE</span>
        <span class="font-handwriting text-lg text-[#9e3a2b]">field journal // experience</span>
      </div>
      <h2 class="font-typewriter text-3xl sm:text-4xl font-bold text-[#e6dfd3] mt-1">
        WORK LOGS &amp; SERVICE TIMELINE
      </h2>
    </div>
    <div class="font-typewriter text-xs text-[#9c9384] max-w-sm">
      *Chronological diary logs written during live commercial game cycles.
    </div>
  </div>

  <!-- Notebook Entries -->
  <div class="space-y-10">
    {entries.map((entry, index) => (
      <div class="paper-sheet rounded-xs p-6 sm:p-8 border border-[#d6cdbd] relative">
        
        <!-- Masking tape strip on top of journal page -->
        <div class="masking-tape" style={`top: -10px; left: ${index % 2 === 0 ? '15%' : '70%'}; width: 90px; height: 20px; transform: rotate(${index % 2 === 0 ? '-2deg' : '2deg'});`}></div>

        <!-- Journal Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b-2 border-dashed border-[#cfc4b2] pb-4 mb-5">
          <div>
            <div class="font-handwriting text-lg text-[#9e3a2b] font-bold">
              Journal Entry #{index + 1} &bull; {entry.location}
            </div>
            <h3 class="font-typewriter text-2xl sm:text-3xl font-black text-[#1c1b18]">
              {entry.role}
            </h3>
            <div class="font-typewriter text-sm font-bold text-[#2e3a23]">
              @ {entry.company}
            </div>
          </div>

          <div class="flex flex-col sm:items-end gap-1">
            <span class="font-typewriter text-xs font-bold text-[#1c1b18] bg-[#ded5c4] px-2.5 py-1 rounded-xs border border-[#cfc4b2]">
              📅 {entry.dates}
            </span>
            <span class="stamp-moss text-[9px]">
              {entry.status}
            </span>
          </div>
        </div>

        <!-- Bulleted Field Log -->
        <div class="space-y-3 mb-6">
          <div class="font-typewriter text-xs font-bold text-[#5c5344] uppercase">
            // FIELD ACCOMPLISHMENTS &amp; CODE MILESTONES:
          </div>
          <ul class="space-y-2 font-serif text-sm text-[#2b271f]">
            {entry.bullets.map((b) => (
              <li class="flex items-start gap-2">
                <span class="text-[#9e3a2b] font-bold mt-0.5">✔</span>
                <span class="leading-relaxed">{b}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tools Used / Stamped Badges -->
        <div class="pt-3 border-t border-[#cfc4b2] flex flex-wrap items-center gap-2">
          <span class="font-typewriter text-[10px] text-[#7a7162] uppercase font-bold mr-1">KIT USED:</span>
          {entry.tools.map((t) => (
            <span class="font-typewriter text-xs px-2 py-0.5 bg-[#e6dfd3] text-[#2e3a23] border border-[#cfc4b2] rounded-xs font-bold">
              {t}
            </span>
          ))}
        </div>

      </div>
    ))}
  </div>

</section>
