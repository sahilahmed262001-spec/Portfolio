---
// src/components/SurvivalInventory.astro
// Tech Stack & Gear Inventory on Rugged Survivor Workbench Grid

const inventoryPacks = [
  {
    category: "PRIMARY WEAPONRY & ENGINE TOOLS",
    icon: "fa-hammer",
    items: [
      { name: "C# (.NET Core & Unity CLR)", condition: "Mastered", durability: 98, note: "Memory management, data structures, event buses, gameplay math" },
      { name: "Unity Engine (6 / 2022.3 LTS)", condition: "Mastered", durability: 96, note: "URP, job systems, asset lifecycles, memory profiling" },
      { name: "Gameplay Mechanics & Physics", condition: "Field-tested", durability: 94, note: "Raycast vehicle physics, spell projectile combat, collision solvers" },
      { name: "Shader Graph & Visual FX", condition: "Equipped", durability: 88, note: "Surface shaders, vertex animation, screen distortion, mobile FX" },
      { name: "Addressables & Asset Bundles", condition: "Equipped", durability: 86, note: "Dynamic streaming, remote asset hosting, zero-hiccup loading" }
    ]
  },
  {
    category: "COMMS RIG & MULTIPLAYER NETCODE",
    icon: "fa-radio",
    items: [
      { name: "Unity Netcode for GameObjects (NGO)", condition: "Mission-proven", durability: 94, note: "Client-side prediction, server reconciliation, NetworkVariables" },
      { name: "Photon PUN & Photon Fusion", condition: "Active", durability: 90, note: "Cloud matchmaking rooms, distributed authority, lag compensation" },
      { name: "Client-Server State Sync", condition: "Active", durability: 92, note: "Delta compression, custom serialization, anti-cheat architecture" }
    ]
  },
  {
    category: "CRAFTING & 3D PROTOTYPING KITS",
    icon: "fa-cube",
    items: [
      { name: "ProBuilder Level Blocking", condition: "Mastered", durability: 95, note: "Rapid level grayboxing, modular obstacles, instant playtesting" },
      { name: "Blender 3D Asset Pipeline", condition: "Equipped", durability: 84, note: "Model navigation, asset integration, coordinate transforms, LODs" },
      { name: "Figma UI/UX & Canvas", condition: "Equipped", durability: 88, note: "Cross-platform mobile & VR layout scaling, UI design skins" }
    ]
  },
  {
    category: "FIELD MUNITIONS & STORE DEPLOYMENTS",
    icon: "fa-shield-halved",
    items: [
      { name: "Android & Google Play Console", condition: "Production", durability: 96, note: "AAB releases, Target SDK updates, automated build pipelines" },
      { name: "VR / AR Hardware Deployment", condition: "Defense-grade", durability: 92, note: "Meta Quest, OpenXR, military museum installations" },
      { name: "Mobile Profiling & Optimization", condition: "Optimized", durability: 94, note: "Draw call batching, texture atlasing, thermal stability" }
    ]
  }
];
---

<section id="inventory" class="py-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3 border-b border-[#282A2D] pb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="stamp-ink-moss">SURVIVAL KIT</span>
        <span class="font-handwriting text-lg text-[#E0AB48]">equipped tools // workbench</span>
      </div>
      <h2 class="font-typewriter text-3xl sm:text-4xl font-bold text-[#E3DED1] mt-1">
        GEAR &amp; INVENTORY
      </h2>
    </div>
    <div class="font-courier text-xs text-[#A5ABB3] max-w-sm">
      *All technical tools are sharpened and maintained through 4+ years of live game development.
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {inventoryPacks.map((pack) => (
      <div class="field-card p-5 sm:p-6 bg-[#1a1b1d] border border-[#282A2D]">
        <div class="flex items-center justify-between border-b border-[#282A2D] pb-3 mb-4">
          <div class="font-typewriter text-sm font-bold text-[#E3DED1] flex items-center gap-2">
            <i class={`fa-solid ${pack.icon} text-[#8EA870]`}></i>
            <span>{pack.category}</span>
          </div>
          <span class="font-handwriting text-sm text-[#E0AB48] font-bold">ready</span>
        </div>

        <div class="space-y-4">
          {pack.items.map((item) => (
            <div class="bg-[#151618] p-3.5 border border-[#232528] rounded-xs group hover:border-[#5E7A45] transition-colors">
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="font-courier text-xs sm:text-sm font-bold text-[#E3DED1] group-hover:text-[#8EA870] transition-colors">
                  {item.name}
                </span>
                <span class="stamp-ink-moss text-[9px]">
                  {item.condition}
                </span>
              </div>

              <p class="font-body text-xs text-[#A5ABB3] mb-2 leading-relaxed">
                {item.note}
              </p>

              <!-- Durability Meter -->
              <div class="space-y-1">
                <div class="flex justify-between font-courier text-[10px] text-[#7A8087]">
                  <span>EFFICIENCY RATING</span>
                  <span class="font-handwriting text-xs text-[#E0AB48] font-bold">{item.durability}%</span>
                </div>
                <div class="h-2 w-full bg-[#1c1e20] rounded-xs overflow-hidden p-0.5 border border-[#282A2D]">
                  <div 
                    class="h-full bg-gradient-to-r from-[#2E3A23] to-[#8EA870] rounded-xs transition-all duration-500"
                    style={`width: ${item.durability}%`}
                  ></div>
                </div>
              </div>

            </div>
          ))}
        </div>

      </div>
    ))}
  </div>

</section>
