---
// src/components/Hero.astro
// Survivor Logbook Stamped Header
---

<section id="hero" class="pt-8 pb-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <div class="field-card p-6 sm:p-10 border border-[#33363A] bg-[#1a1b1d] relative">
    
    <!-- Physical Duct/Masking Tape Strip on Top -->
    <div class="tape-strip tape-top-center"></div>
    
    <!-- Paperclip Graphic Top Left -->
    <div class="absolute -top-3 left-8 text-2xl text-[#7A8087] select-none">
      📎
    </div>

    <!-- Header Stamps & Metadata -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#282A2D] pb-4 mb-6">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="stamp-ink-rust">ENTRY #1461</span>
        <span class="stamp-ink-moss">SECTOR: ASIA-NORTH</span>
        <span class="font-courier text-xs text-[#A5ABB3] font-bold">EXPEDITION: 4+ YEARS</span>
      </div>
      <div class="font-handwriting text-lg text-[#E0AB48] font-bold">
        *Verified field-ready
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Name & Logbook -->
      <div class="lg:col-span-8 space-y-5">
        <div>
          <h1 class="font-typewriter text-3xl sm:text-5xl font-black text-[#E3DED1] tracking-tight">
            SAHIL AHMED
          </h1>
          <div class="flex flex-wrap items-center gap-2 mt-2">
            <span class="font-courier text-sm sm:text-base font-bold text-[#E0AB48] bg-[#241e12] px-2.5 py-0.5 rounded-xs border border-[#4d3d19]">
              &gt; Unity Systems &amp; Gameplay Engineer
            </span>
            <span class="font-handwriting text-lg text-[#8EA870] font-bold">
              (Multiplayer &amp; XR Specialist)
            </span>
          </div>
        </div>

        <!-- Summary Note Box in Clean Sans-Serif Body Text -->
        <div class="bg-[#151618] p-5 rounded-xs border-l-4 border-l-[#5E7A45] border border-[#232528] font-body text-sm leading-relaxed text-[#CFC8BA]">
          <p class="font-bold font-typewriter text-xs text-[#8EA870] mb-2 uppercase tracking-wide">
            // LOGBOOK SUMMARY:
          </p>
          <p>
            Innovative Unity Game Developer with <strong class="text-[#E3DED1]">4 years of hands-on experience</strong> specializing in multiplayer game architecture, casual mobile titles, and immersive AR/VR experiences. Highly proficient in C#, Unity Netcode for GameObjects (NGO), Photon (PUN &amp; Fusion), and ProBuilder.
          </p>
          <p class="mt-2.5 text-[#A5ABB3]">
            Proven track record of architecting, optimizing, and deploying high-profile interactive VR applications for national defense (<strong class="text-[#E0AB48]">officially inaugurated by the Chief of Defence Staff, General Anil Chauhan</strong>) as well as commercially published mobile titles across Google Play.
          </p>
        </div>

        <!-- Duct Tape Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a href="#reports" class="btn-tape-moss text-xs">
            <span>📁 READ FIELD REPORTS</span>
          </a>
          <a href="#inventory" class="btn-tape-yellow text-xs">
            <span>🎒 GEAR INVENTORY</span>
          </a>
          <a href="#radio" class="btn-tape-rust text-xs">
            <span>📻 EMERGENCY RADIO</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Radio Telemetry Post-It Note -->
      <div class="lg:col-span-4">
        <div class="bg-[#1e1c17] p-5 rounded-xs border border-[#42371e] shadow-lg relative transform rotate-[1deg]">
          <div class="tape-strip" style="top: -8px; left: 30%; width: 70px; height: 18px; transform: rotate(-3deg);"></div>
          
          <div class="font-typewriter text-xs font-bold text-[#E0AB48] border-b border-[#362e1a] pb-2 mb-3 flex items-center justify-between">
            <span>📻 RADIO FREQUENCIES</span>
            <span class="stamp-ink-rust text-[9px]">LIVE</span>
          </div>

          <div class="space-y-3 font-courier text-xs text-[#E3DED1]">
            <div>
              <span class="text-[10px] text-[#7A8087] block font-bold uppercase">DIRECT PHONE / WHATSAPP:</span>
              <a href="tel:+918171638120" class="font-bold text-[#E3DED1] hover:text-[#E0AB48] underline text-sm mt-0.5 block">
                +91 8171638120
              </a>
            </div>

            <div>
              <span class="text-[10px] text-[#7A8087] block font-bold uppercase">WRITTEN DISPATCH (EMAIL):</span>
              <a href="mailto:sahilahmed262001@gmail.com" class="font-bold text-[#E0AB48] hover:underline text-xs break-all mt-0.5 block">
                sahilahmed262001@gmail.com
              </a>
            </div>

            <div>
              <span class="text-[10px] text-[#7A8087] block font-bold uppercase">SURVIVOR NETWORK:</span>
              <a href="https://linkedin.com/in/sahil-ahmed-81018a228" target="_blank" rel="noopener noreferrer" class="font-bold text-[#8EA870] hover:underline text-xs mt-0.5 block">
                linkedin.com/in/sahil-ahmed
              </a>
            </div>

            <div>
              <span class="text-[10px] text-[#7A8087] block font-bold uppercase">OUTPOST BASE:</span>
              <span class="text-[#CFC8BA] font-bold text-xs mt-0.5 block">Muradnagar, Uttar Pradesh, India</span>
            </div>
          </div>

          <div class="mt-4 pt-2 border-t border-[#362e1a] font-handwriting text-base text-[#E0AB48] font-bold">
            ~ "Available for full-time &amp; contract missions"
          </div>
        </div>
      </div>

    </div>

  </div>

</section>
