---
// src/components/ArchiveRecords.astro
// Education & Academic Archives on stamped survivor record cards

const archives = [
  {
    type: "ACADEMIC ARCHIVE // DEGREE",
    title: "Bachelor of Technology (B.Tech) in Computer Science",
    institution: "APJ Abdul Kalam Technological University",
    dates: "2019 – 2023",
    tag: "GRADUATED // CS",
    note: "Specialized in Computer Graphics, Game Physics Math, Algorithms, Object-Oriented Software Architecture, and Distributed Systems.",
    stamp: "VERIFIED GRADUATE"
  },
  {
    type: "DEFENSE COMMENDATION",
    title: "National Defense VR Museum Tribute",
    institution: "Indian Military Nursing Service (IMNS) & Armed Forces",
    dates: "SPECIAL",
    tag: "NATIONAL DEFENSE",
    note: "Built immersive VR museum commemorating 100 Years of IMNS. Officially inaugurated by Chief of Defence Staff, General Anil Chauhan.",
    stamp: "MINISTRY INAUGURATED"
  },
  {
    type: "STORE ARCHIVES // GOOGLE PLAY",
    title: "Commercial Android Publishing",
    institution: "Google Play Console / Production Releases",
    dates: "2022 – 2026",
    tag: "PRODUCTION VERIFIED",
    note: "Engineered and shipped Mystic Motors, Merge Balls, and Tile Pop. Full compliance with Target SDKs, 64-bit builds, and dynamic memory delivery.",
    stamp: "100% STORE PASS"
  }
];
---

<section id="archives" class="py-12 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3 border-b border-[#282A2D] pb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="stamp-ink-moss">ARCHIVES</span>
        <span class="font-handwriting text-lg text-[#CFC8BA]">verified credentials</span>
      </div>
      <h2 class="font-typewriter text-3xl sm:text-4xl font-bold text-[#E3DED1] mt-1">
        ACADEMIC &amp; CITATION RECORDS
      </h2>
    </div>
    <div class="font-courier text-xs text-[#A5ABB3] max-w-sm">
      *Official records, degree citations, and defense ministry tributes.
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {archives.map((item) => (
      <div class="field-card p-5 bg-[#1a1b1d] border border-[#282A2D] flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between font-courier text-[10px] text-[#7A8087] pb-2 border-b border-[#282A2D] mb-3">
            <span class="uppercase font-bold">{item.type}</span>
            <span class="text-[#C7523C] font-bold">{item.dates}</span>
          </div>

          <h3 class="font-typewriter text-lg font-bold text-[#E3DED1] mb-1 leading-snug">
            {item.title}
          </h3>

          <div class="font-courier text-xs text-[#8EA870] font-bold mb-3">
            {item.institution}
          </div>

          <p class="font-body text-xs text-[#A5ABB3] leading-relaxed mb-4">
            {item.note}
          </p>
        </div>

        <div class="pt-3 border-t border-[#282A2D] flex items-center justify-between">
          <span class="font-handwriting text-sm text-[#E0AB48] font-bold">
            {item.tag}
          </span>
          <span class="stamp-ink-moss text-[9px]">
            {item.stamp}
          </span>
        </div>
      </div>
    ))}
  </div>

</section>
